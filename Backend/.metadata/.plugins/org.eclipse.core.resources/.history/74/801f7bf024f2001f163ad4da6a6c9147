@Service
public class MovementDetailService implements IMovementDetailService {

	@Autowired
	private MovementDetailRepository movementDetailRepository;

	@Autowired
	private MovementDetailMapper movementDetailMapper;

	@Autowired
	private PartRepository partRepository;

	@Autowired
	private ArticleRepository articleRepository;

	@Autowired
	private ComponentRepository componentRepository;

	@Autowired
	private WarehouseRepository warehouseRepository;

	@Autowired
	private WorkerRepository workerRepository;

	@Autowired
	private StockService stockService;

	@Autowired
	private StockRepository stockRepository;

	private void validateSingleItem(MovementDetailDTO movementDetailDTO) {
		int count = 0;
		if (movementDetailDTO.getPartId() != null)
			count++;
		if (movementDetailDTO.getArticleId() != null)
			count++;
		if (movementDetailDTO.getComponentId() != null)
			count++;

		if (count != 1) {
			throw new OurException("Debe proporcionar exactamente uno de PartId, ArticleId o ComponentId.");
		}
	}

	@Override
	public Response updateStock(MovementDetail movementDetail, Warehouse origin, Warehouse destination) {
		Response response = new Response();
		int quantity = movementDetail.getQuantity();
		TypeMovementWarehouse type = movementDetail.getTypeMovementWarehouse();

		try {
			// Validar cantidad positiva
			if (quantity <= 0) {
				throw new OurException("La cantidad debe ser mayor que cero.");
			}

			// Obtener stock en el almacén de origen y destino
			Stock stockOrigin = stockRepository.findByWarehouseAndItem(origin, movementDetail.getPart(),
					movementDetail.getArticle(), movementDetail.getComponent());
			Stock stockDestination = stockRepository.findByWarehouseAndItem(destination, movementDetail.getPart(),
					movementDetail.getArticle(), movementDetail.getComponent());

			// Actualizar stock en el almacén de origen
			if (type == TypeMovementWarehouse.EXIT || type == TypeMovementWarehouse.TRANSFER) {
				if (stockOrigin == null) {
					if (quantity > 0) {
						stockOrigin = new Stock();
						stockOrigin.setQuantity(quantity);
						if (movementDetail.getPart() != null) {
							stockOrigin.setPart(movementDetail.getPart());
						} else if (movementDetail.getArticle() != null) {
							stockOrigin.setArticle(movementDetail.getArticle());
						} else if (movementDetail.getComponent() != null) {
							stockOrigin.setComponent(movementDetail.getComponent());
						}
					} else {
						throw new OurException("No hay stock suficiente para la operación.");
					}
				} else {
					int newQuantity = stockOrigin.getQuantity() - quantity;
					if (newQuantity < 0) {
						throw new OurException("No hay suficiente stock en el almacén.");
					}
					stockOrigin.setQuantity(newQuantity);
				}
			}

			// Actualizar stock en el almacén de destino
			if (type == TypeMovementWarehouse.ENTRY || type == TypeMovementWarehouse.TRANSFER) {
				if (stockDestination == null) {
					stockDestination = new Stock();
					stockDestination.setQuantity(quantity);
					if (movementDetail.getPart() != null) {
						stockDestination.setPart(movementDetail.getPart());
					} else if (movementDetail.getArticle() != null) {
						stockDestination.setArticle(movementDetail.getArticle());
					} else if (movementDetail.getComponent() != null) {
						stockDestination.setComponent(movementDetail.getComponent());
					}
				} else {
					int newQuantity = stockDestination.getQuantity() + quantity;
					stockDestination.setQuantity(newQuantity);
				}
				// Guardar los cambios en el repositorio
				if (stockOrigin != null) {
					stockRepository.save(stockOrigin);
				}
				if (stockDestination != null) {
					stockRepository.save(stockDestination);
				}

				response.setStatusCode(200);
				response.setMessage("Stock actualizado exitosamente.");
			}
		} catch (OurException e) {
			response.setStatusCode(400);
			response.setMessage(e.getMessage());
		} catch (Exception e) {
			response.setStatusCode(500);
			response.setMessage("Error al actualizar el stock: " + e.getMessage());
		}

		return response;
	}

	@Override
	public Response updateMovementDetail(Long id, MovementDetailDTO movementDetailDTO) {
		Response response = new Response();

		try {
			MovementDetail movementDetail = movementDetailRepository.findById(id)
					.orElseThrow(() -> new OurException("Movimiento no encontrado con ID: " + id));

			movementDetail.setQuantity(movementDetailDTO.getQuantity());
			movementDetail.setTypeMovementWarehouse(movementDetailDTO.getTypeMovementWarehouse());

			Part part = partRepository.findById(movementDetailDTO.getPartId()).orElseThrow(
					() -> new OurException("Parte no encontrada con ID: " + movementDetailDTO.getPartId()));
			movementDetail.setPart(part);

			Article article = articleRepository.findById(movementDetailDTO.getArticleId()).orElseThrow(
					() -> new OurException("Artículo no encontrado con ID: " + movementDetailDTO.getArticleId()));
			movementDetail.setArticle(article);

			Component component = componentRepository.findById(movementDetailDTO.getComponentId()).orElseThrow(
					() -> new OurException("Componente no encontrado con ID: " + movementDetailDTO.getComponentId()));
			movementDetail.setComponent(component);

			MovementDetail updatedMovement = movementDetailRepository.save(movementDetail);

			response.setStatusCode(200);
			response.setMessage("Movimiento actualizado exitosamente");
			response.setMovementDetail(movementDetailMapper.movementDetailToMovementDetailDTO(updatedMovement));

		} catch (OurException e) {
			response.setStatusCode(400);
			response.setMessage(e.getMessage());
		} catch (Exception e) {
			response.setStatusCode(500);
			response.setMessage("Error al actualizar el movimiento: " + e.getMessage());
		}

		return response;
	}

	@Override
	public Response deleteMovementDetail(Long workerId, @AuthenticationPrincipal Worker currentUser) {

		Response response = new Response();

		try {
			if (!currentUser.getRole().equals(Role.ADMINISTRATOR)) {
				throw new OurException("No tienes permisos para eliminar movimientos");
			}

			if (!movementDetailRepository.existsById(workerId)) {
				throw new OurException("Movimiento no encontrado con ID: " + workerId);
			}

			movementDetailRepository.deleteById(workerId);
			response.setStatusCode(200);
			response.setMessage("Movimiento eliminado exitosamente.");

		} catch (OurException e) {

			response.setStatusCode(404);
			response.setMessage(e.getMessage());

		} catch (Exception e) {

			response.setStatusCode(500);
			response.setMessage("Error al eliminar el movimiento: " + e.getMessage());

		}

		return response;
	}

	@Override
	public Response getMovementDetailById(Long id) {

		Response response = new Response();

		try {

			MovementDetail movementDetail = movementDetailRepository.findById(id)
					.orElseThrow(() -> new OurException("Movimiento no encontrado con ID: " + id));

			MovementDetailDTO movementDetailDTO = movementDetailMapper
					.movementDetailToMovementDetailDTO(movementDetail);
			response.setStatusCode(200);
			response.setMovementDetail(movementDetailDTO);

		} catch (OurException e) {

			response.setStatusCode(400);
			response.setMessage(e.getMessage());

		} catch (Exception e) {

			response.setStatusCode(500);
			response.setMessage("Error al buscar el movimiento: " + e.getMessage());

		}

		return response;
	}

	@Override
	public Response getAllMovementDetails() {

		Response response = new Response();

		try {
			List<MovementDetail> movementDetails = movementDetailRepository.findAll();

			response.setStatusCode(200);
			response.setMessage("Lista de movimientos obtenida exitosamente");
			response.setMovementDetailList(movementDetailMapper.movementDetailsToMovementDetailDTOs(movementDetails));

		} catch (Exception e) {
			response.setStatusCode(500);
			response.setMessage("Error al obtener los movimientos: " + e.getMessage());
		}

		return response;
	}
}
