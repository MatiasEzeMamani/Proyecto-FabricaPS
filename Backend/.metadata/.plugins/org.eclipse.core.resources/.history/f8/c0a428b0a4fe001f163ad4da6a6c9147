package com.proyecto.fabrica.ps.mapper;

import java.util.List;

import org.mapstruct.Mapper;
import org.mapstruct.Mapping;

import com.proyecto.fabrica.ps.dto.MovementDetailDTO;
import com.proyecto.fabrica.ps.models.MovementDetail;

@Mapper(componentModel = "spring")
public interface MovementDetailMapper {
	

    @Mapping(source = "originWarehouse.id", target = "originWarehouseId")
    @Mapping(source = "destinationWarehouse.id", target = "destinationWarehouseId")
    @Mapping(source = "part.id", target = "partId")
    @Mapping(source = "component.id", target = "componentId")
    @Mapping(source = "article.id", target = "articleId")
    @Mapping(source = "worker.id", target = "workerId")
	MovementDetailDTO movementDetailToMovementDetailDTO(MovementDetail movementDetail);

	List<MovementDetailDTO> movementDetailsToMovementDetailDTOs(List<MovementDetail> movementDetails);

}
