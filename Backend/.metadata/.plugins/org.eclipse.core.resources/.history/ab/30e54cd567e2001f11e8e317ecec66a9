package com.proyecto.fabrica.ps.service.impl;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.proyecto.fabrica.ps.dto.Response;
import com.proyecto.fabrica.ps.exception.OurException;
import com.proyecto.fabrica.ps.mapper.ComponentPartMapper;
import com.proyecto.fabrica.ps.models.Component;
import com.proyecto.fabrica.ps.models.ComponentPart;
import com.proyecto.fabrica.ps.models.Part;
import com.proyecto.fabrica.ps.models.Role;
import com.proyecto.fabrica.ps.models.Worker;
import com.proyecto.fabrica.ps.repositories.ComponentPartRepository;
import com.proyecto.fabrica.ps.repositories.ComponentRepository;
import com.proyecto.fabrica.ps.repositories.PartRepository;
import com.proyecto.fabrica.ps.service.interfac.IComponentPartService;

@Service
public class ComponentPartService implements IComponentPartService {

	@Autowired
	private ComponentPartRepository componentPartRepository;

	@Autowired
	private ComponentRepository componentRepository;

	@Autowired
	private PartRepository partRepository;

	@Autowired
	private ComponentPartMapper componentPartMapper;

	@Override
	public Response addComponentPart(Long componentId, Long partId, int quantity) {
		Response response = new Response();

		try {
			// Buscar el componente
			Component component = componentRepository.findById(componentId)
					.orElseThrow(() -> new OurException("Componente no encontrado con ID: " + componentId));

			// Buscar la pieza
			Part part = partRepository.findById(partId)
					.orElseThrow(() -> new OurException("Pieza no encontrada con ID: " + partId));

			// Crear y configurar la entidad ComponentPart
			ComponentPart componentPart = new ComponentPart();
			componentPart.setComponent(component);
			componentPart.setPart(part);
			componentPart.setQuantityPerComponent(quantity);

			// Guardar en la base de datos
			ComponentPart savedComponentPart = componentPartRepository.save(componentPart);

			// Configurar la respuesta
			response.setStatusCode(200);
			response.setMessage("Componente-Parte agregada correctamente.");
			response.setComponentPart(componentPartMapper.componentPartToComponentPartDTO(savedComponentPart));

		} catch (OurException e) {
			response.setStatusCode(404);
			response.setMessage(e.getMessage());
		} catch (Exception e) {
			response.setStatusCode(500);
			response.setMessage("Error interno al agregar el componente-parte: " + e.getMessage());
			e.printStackTrace(); // Agrega logging en una aplicación real
		}

		return response;
	}

	@Override
	public Response getAllComponentsParts() {

		Response response = new Response();

		try {

			List<ComponentPart> componentParts = componentPartRepository.findAll();

			response.setStatusCode(200);
			response.setMessage("Lista de partes de componentes obtenida exitosamente");
			response.setComponentPartList(componentPartMapper.componentPartsToComponentPartDTOs(componentParts));

		} catch (Exception e) {

			response.setStatusCode(500);
			response.setMessage("Error al obtener las partes de componentes: " + e.getMessage());

		}

		return response;
	}

	@Override
	public Response getComponentPartByComponent(Long componentId) {

		Response response = new Response();

		try {

			Component component = componentRepository.findById(componentId)
	                .orElseThrow(() -> new OurException("Componente no encontrado con ID: " + componentId));
	        
	        List<ComponentPart> componentParts = componentPartRepository.findByComponentId(component);
			
			response.setStatusCode(200);
			response.setMessage("Lista de partes del componente obtenida exitosamente");
			response.setComponentPartList(componentPartMapper.componentPartsToComponentPartDTOs(componentParts));

		} catch (Exception e) {

			response.setStatusCode(500);
			response.setMessage("Error al obtener las partes del componente: " + e.getMessage());

		}

		return response;
	}

	@Override
	public Response getComponentPartByPart(Long partId) {

		Response response = new Response();

		try {

			Part part = partRepository.findById(partId)
	                .orElseThrow(() -> new OurException("Pieza no encontrado con ID: " + partId));
	        
	        List<ComponentPart> componentParts = componentPartRepository.findByPartId(part);

			response.setStatusCode(200);
			response.setMessage("Lista de componentes que usan esta parte obtenida exitosamente");
			response.setComponentPartList(componentPartMapper.componentPartsToComponentPartDTOs(componentParts));

		} catch (Exception e) {

			response.setStatusCode(500);
			response.setMessage("Error al obtener los componentes que usan esta parte: " + e.getMessage());

		}

		return response;
	}

	@Override
	public Response deleteComponentPart(Long componentPartId, Worker currentUser) {
		
		Response response = new Response();
		
		try {
		
			if (!currentUser.getRole().equals(Role.ADMINISTRATOR)) {
				throw new OurException("No tienes permisos para eliminar partes de componentes");
			}

			if (!componentPartRepository.existsById(componentPartId)) {
				throw new OurException("Parte de componente no encontrada con ID: " + componentPartId);
			}

			componentPartRepository.deleteById(componentPartId);
			response.setStatusCode(200);
			response.setMessage("Parte de componente eliminada exitosamente.");

		} catch (OurException e) {
			response.setStatusCode(400);
			response.setMessage(e.getMessage());

		} catch (Exception e) {
			response.setStatusCode(500);
			response.setMessage("Error al eliminar la parte de componente: " + e.getMessage());
		}

		return response;
	}

}
