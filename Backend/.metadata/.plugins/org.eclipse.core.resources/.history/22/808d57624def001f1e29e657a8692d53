	@Override
	public Response addMovementDetail(MovementDetailDTO movementDetailDTO) {

		Response response = new Response();

		try {

			MovementDetail movementDetail = new MovementDetail();
			movementDetail.setQuantity(movementDetailDTO.getQuantity());
			movementDetail.setTypeMovementWarehouse(movementDetailDTO.getTypeMovementWarehouse());

			Part part = partRepository.findById(movementDetailDTO.getPartId()).orElseThrow(
					() -> new OurException("Parte no encontrada con ID: " + movementDetailDTO.getPartId()));
			movementDetail.setPart(part);

			Article article = articleRepository.findById(movementDetailDTO.getArticleId())
					.orElseThrow(() -> new OurException(
							"Artículo no encontrado con ID: " + movementDetailDTO.getArticleId()));
			movementDetail.setArticle(article);

			Component component = componentRepository.findById(movementDetailDTO.getComponentId())
					.orElseThrow(() -> new OurException(
							"Componente no encontrado con ID: " + movementDetailDTO.getComponent().getComponentId()));
			movementDetail.setComponent(component);

			MovementDetail savedMovement = movementDetailRepository.save(movementDetail);
		} catch (OurException e) {

		}
		return null;
	}

