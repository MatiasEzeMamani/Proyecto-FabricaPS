package com.proyecto.fabrica.ps.repositories;

import java.util.Optional;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import com.proyecto.fabrica.ps.models.Article;
import com.proyecto.fabrica.ps.models.Component;
import com.proyecto.fabrica.ps.models.Part;
import com.proyecto.fabrica.ps.models.Stock;
import com.proyecto.fabrica.ps.models.Warehouse;

@Repository
public interface StockRepository extends JpaRepository<Stock, Long> {

	@Query("SELECT s FROM Stock s WHERE s.warehouse = :warehouse AND s.part = :part")
    Optional<Stock> findByWarehouseAndPart(@Param("warehouse") Warehouse warehouse, @Param("part") Part part);

    @Query("SELECT s FROM Stock s WHERE s.warehouse = :warehouse AND s.article = :article")
    Optional<Stock> findByWarehouseAndArticle(@Param("warehouse") Warehouse warehouse, @Param("article") Article article);

    @Query("SELECT s FROM Stock s WHERE s.warehouse = :warehouse AND s.component = :component")
    Optional<Stock> findByWarehouseAndComponent(@Param("warehouse") Warehouse warehouse, @Param("component") Component component);

    Optional<Stock> findByWarehouseAndPart(Warehouse warehouse, Part part);
}