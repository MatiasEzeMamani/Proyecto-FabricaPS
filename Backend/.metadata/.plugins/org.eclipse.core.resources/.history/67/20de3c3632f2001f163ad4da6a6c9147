package com.proyecto.fabrica.ps.service.impl;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.proyecto.fabrica.ps.models.Part;
import com.proyecto.fabrica.ps.models.Stock;
import com.proyecto.fabrica.ps.models.Warehouse;
import com.proyecto.fabrica.ps.repositories.PartRepository;
import com.proyecto.fabrica.ps.repositories.StockRepository;
import com.proyecto.fabrica.ps.repositories.WarehouseRepository;

@Service
public class StockService {

    @Autowired
    private StockRepository stockRepository;

    @Autowired
    private WarehouseRepository warehouseRepository;

    @Autowired
    private PartRepository partRepository;

    public Stock createOrUpdateStock(Long warehouseId, Long partId, int quantity) {
        // Busca el almacén y la pieza
        Warehouse warehouse = warehouseRepository.findById(warehouseId)
                .orElseThrow(() -> new RuntimeException("Warehouse not found"));
        Part part = partRepository.findById(partId)
                .orElseThrow(() -> new RuntimeException("Part not found"));

        // Busca si ya existe el stock para este almacén y parte
        Stock stock = stockRepository.findByWarehouseAndPart(warehouse, part);

        if (stock == null) {
            // Si no existe, crea un nuevo stock
            stock = new Stock();
            stock.setWarehouse(warehouse);
            stock.setPart(part);
            stock.setQuantity(quantity);
        } else {
            // Si existe, actualiza la cantidad (puedes ajustarlo según lo que necesites)
            stock.setQuantity(stock.getQuantity() + quantity);
        }

        // Guarda o actualiza el stock
        return stockRepository.save(stock);
    }
}