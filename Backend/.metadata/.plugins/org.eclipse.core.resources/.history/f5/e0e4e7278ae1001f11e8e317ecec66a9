package com.proyecto.fabrica.ps.service.impl;

public class ComponentPartService {

	@Service
	public class ComponentPartService implements IComponentPartService {
		
		@Autowired
		private ComponentPartRepository componentPartRepository;
		
		@Autowired
		private ComponentRepository componentRepository;
		
		@Autowired
		private PartRepository partRepository;
		
		@Autowired
		private ComponentPartMapper componentPartMapper;
		
		@Override
		public Response addComponentPart(Long componentId, Long partId, int quantity) {
		    Response response = new Response();
		    
		    try {
		        // Buscar el componente
		        Component component = componentRepository.findById(componentId)
		                .orElseThrow(() -> new OurException("Componente no encontrado con ID: " + componentId));

		        // Buscar la pieza
		        Part part = partRepository.findById(partId)
		                .orElseThrow(() -> new OurException("Pieza no encontrada con ID: " + partId));

		        // Crear y configurar la entidad ComponentPart
		        ComponentPart componentPart = new ComponentPart();
		        componentPart.setComponent(component);
		        componentPart.setPart(part);
		        componentPart.setQuantity_per_component(quantity);

		        // Guardar en la base de datos
		        ComponentPart savedComponentPart = componentPartRepository.save(componentPart);

		        // Configurar la respuesta
		        response.setStatusCode(200);
		        response.setMessage("Componente-Parte agregada correctamente.");
		        response.setComponentPart(componentPartMapper.componentPartToComponentPartDTO(savedComponentPart));

		    } catch (OurException e) {
		        response.setStatusCode(404);
		        response.setMessage(e.getMessage());
		    } catch (Exception e) {
		        response.setStatusCode(500);
		        response.setMessage("Error interno al agregar el componente-parte: " + e.getMessage());
		        e.printStackTrace(); // Agrega logging en una aplicación real
		    }
		    
		    return response;
		}

