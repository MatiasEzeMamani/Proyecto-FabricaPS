package com.proyecto.fabrica.ps.repositories;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import com.proyecto.fabrica.ps.models.Article;
import com.proyecto.fabrica.ps.models.Component;
import com.proyecto.fabrica.ps.models.Part;
import com.proyecto.fabrica.ps.models.Stock;
import com.proyecto.fabrica.ps.models.Warehouse;

@Repository
public interface StockRepository extends JpaRepository<Stock, Long> {

	@Query("SELECT s FROM Stock s WHERE s.warehouse = :warehouse " +
	           "AND (s.part = :part OR s.article = :article OR s.component = :component)")
	    Stock findByWarehouseAndItem(@Param("warehouse") Warehouse warehouse, 
	                                 @Param("part") Part part, 
	                                 @Param("article") Article article, 
	                                 @Param("component") Component component);
}
