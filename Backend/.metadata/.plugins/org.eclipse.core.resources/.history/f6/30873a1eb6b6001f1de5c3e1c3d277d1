	@Autowired
	private ArticleRepository articleRepository;
	
	@Autowired
	private BagRepository bagRepository;
	
	@Autowired
	private HoseRepository hoseRepository;
	
	@Autowired
	private ScrewRepository screwRepository;
	
	@Override
	public Response addArticle(ArticleDTO articleDTO) {

		Response response = new Response();
		
		try {
			
			if (articleRepository.existsByCode(articleDTO.getCode())) {
				throw new OurException("El articulo con el codigo " + articleDTO.getCode() + " ya esta registrada.");
			}
			
			Article article = new Article();
			article.setCode(articleDTO.getCode());
			article.setName(articleDTO.getName());
			article.setToluene(articleDTO.isToluene());
			article.setSpring(articleDTO.isSpring());
			
			Bag bag = bagRepository.findById(articleDTO.getBag().getBagId()).orElseThrow(
					() -> new OurException("Bolsa no encontrada con ID: " + articleDTO.getBag().getBagId()));
			article.setBag(bag);

			Hose hose = hoseRepository.findById(articleDTO.getHose().getHoseId()).orElseThrow(
					() -> new OurException("Manguera no encontrada con ID: " + articleDTO.getHose().getHoseId()));
			article.setHose(hose);
			
			Screw screw = screwRepository.findById(articleDTO.getScrew().getScrewId()).orElseThrow(
					() -> new OurException("Tornillo no encontrado con ID: " + articleDTO.getScrew().getScrewId()));
			article.setScrew(screw);
			
			Article saveArticle = articleRepository.save(article);
			
			response.setStatusCode(200);
			response.setMessage("Material añadido exitosamente");
			response.setMaterial(articleMapper.materialToMaterialDTO(saveArticle));
			
		} catch(OurException e) {
			
		} catch(Exception e) {
			
		}
		
		return null;
	}

