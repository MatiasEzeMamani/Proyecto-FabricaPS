@Service
public class ComponentStockService implements IComponentStockService {

	@Autowired
	private ComponentRepository componentRepository;

	@Autowired
	private ComponentStockMapper componentStockMapper;

	private Response createResponse(int statusCode, String message, ComponentStockDTO componentStockDTO) {
		
		Response response = new Response();
		
		response.setStatusCode(statusCode);
		response.setMessage(message);
		response.setComponentStock(componentStockDTO);
		
		return response;
	}

	@Override
	public Response addStock(Long componentId, int quantity) {

		Response response = new Response();
		
		try {
			
			Optional<Component> optionalComponent = componentRepository.findById(componentId);
			
			if( optionalComponent.isEmpty()) {
				return createResponse(400, "Componente no encontrado con ID: " + componentId, null);
			}
			
			Component component = optionalComponent.get();
			component.setStock(component.getStock() + quantity);
			Component updatedComponent = componentRepository.save(component);
			
			ComponentStockDTO componentStockDTO = componentStockMapper.componentToComponentStockDTO(updatedComponent);
			return createResponse(200, "Stock Actualizado correctamente.", componentStockDTO);
		} catch (Exception e) {
			return createResponse(500, "Error al actualizar el stock: " + e.getMessage(), null);
		}
		
		return null;
	}

