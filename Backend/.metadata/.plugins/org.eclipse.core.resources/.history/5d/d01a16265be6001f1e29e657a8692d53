package com.proyecto.fabrica.ps.controllers;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.proyecto.fabrica.ps.service.interfac.IComponentStockService;

@RestController
@RequestMapping("/api/component-stock")
public class ComponentStockController {

	 @Autowired
	 private IComponentStockService componentStockService;
	
	 @PostMapping("/add/{componentId}/{quantity}")
	    public Response addStock(@PathVariable Long componentId, @PathVariable int quantity) {
	        return componentStockService.addStock(componentId, quantity);
	    }

	    @PostMapping("/reduce/{componentId}/{quantity}")
	    public Response reduceStock(@PathVariable Long componentId, @PathVariable int quantity) {
	        return componentStockService.reduceStock(componentId, quantity);
	    }

	    @GetMapping("/{componentId}")
	    public Response getStockByComponentId(@PathVariable Long componentId) {
	        return componentStockService.getStockByComponentId(componentId);
	    }

	    @GetMapping("/all")
	    public Response getAllComponentsStock() {
	        return componentStockService.getAllComponentsStock();
	    }
}
