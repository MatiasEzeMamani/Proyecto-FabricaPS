package com.proyecto.fabrica.ps.controllers;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.security.core.annotation.AuthenticationPrincipal;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.proyecto.fabrica.ps.dto.MovementDetailDTO;
import com.proyecto.fabrica.ps.dto.Response;
import com.proyecto.fabrica.ps.models.Worker;
import com.proyecto.fabrica.ps.service.interfac.IMovementDetailService;

@RestController
@RequestMapping("/api/movement-details")
public class MovementDetailController {
	@Autowired
	private IMovementDetailService movementDetailService;

	// Endpoint para añadir un nuevo movimiento
	@PostMapping
	public ResponseEntity<Response> addMovementDetail(@RequestBody MovementDetailDTO movementDetailDTO,
			@AuthenticationPrincipal Worker currentUser) {	
		if (currentUser != null) {
	        // Asigna el ID del trabajador autenticado
	        movementDetailDTO.setWorkerId(currentUser.getWorkerId());
	    } else {
	        // Si no hay un trabajador autenticado, se devuelve un error
	        return ResponseEntity.status(400).body("El trabajador no está autenticado.");
	    }
		Response response = movementDetailService.addMovementDetail(movementDetailDTO, currentUser);
		return ResponseEntity.status(response.getStatusCode()).body(response);
	}

	// Endpoint para actualizar un movimiento existente
	@PutMapping("/{id}")
	public ResponseEntity<Response> updateMovementDetail(@PathVariable Long id,
			@RequestBody MovementDetailDTO movementDetailDTO) {
		Response response = movementDetailService.updateMovementDetail(id, movementDetailDTO);
		return ResponseEntity.status(response.getStatusCode()).body(response);
	}

	// Endpoint para eliminar un movimiento
	@DeleteMapping("/{id}")
	public ResponseEntity<Response> deleteMovementDetail(@PathVariable Long id,
			@AuthenticationPrincipal Worker currentUser) {
		Response response = movementDetailService.deleteMovementDetail(id, currentUser);
		return ResponseEntity.status(response.getStatusCode()).body(response);
	}

	// Endpoint para obtener un movimiento por ID
	@GetMapping("/{id}")
	public ResponseEntity<Response> getMovementDetailById(@PathVariable Long id) {
		Response response = movementDetailService.getMovementDetailById(id);
		return ResponseEntity.status(response.getStatusCode()).body(response);
	}

	// Endpoint para obtener todos los movimientos
	@GetMapping
	public ResponseEntity<Response> getAllMovementDetails() {
		Response response = movementDetailService.getAllMovementDetails();
		return ResponseEntity.status(response.getStatusCode()).body(response);
	}
}
