package com.proyecto.fabrica.ps.dto.material;

import java.util.List;

import com.proyecto.fabrica.ps.models.Material;

public class ColorDTO {
	
	private Long colorId;
	
	private String name;
	
	private List<Material> materialColor;

	public Long getColorId() {
		return colorId;
	}

	public void setColorId(Long colorId) {
		this.colorId = colorId;
	}

	public String getName() {
		return name;
	}

	public void setName(String name) {
		this.name = name;
	}

	public List<Material> getMaterialColor() {
		return materialColor;
	}

	public void setMaterialColor(List<Material> materialColor) {
		this.materialColor = materialColor;
	}
}
