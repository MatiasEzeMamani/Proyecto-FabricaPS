package com.proyecto.fabrica.ps.service.impl;

import org.springframework.beans.factory.annotation.Autowired;

import com.proyecto.fabrica.ps.dto.Response;
import com.proyecto.fabrica.ps.exception.OurException;
import com.proyecto.fabrica.ps.models.MovementDetail;
import com.proyecto.fabrica.ps.models.Stock;
import com.proyecto.fabrica.ps.models.TypeMovementWarehouse;
import com.proyecto.fabrica.ps.models.Warehouse;
import com.proyecto.fabrica.ps.repositories.StockRepository;
import com.proyecto.fabrica.ps.service.interfac.IStockService;

@Service
public class StockService implements IStockService {

	@Autowired
	private StockRepository stockRepository;
	
	@Override
    public Response updateStock(MovementDetail movementDetail, Warehouse origin, Warehouse destination) {
        Response response = new Response();
        int quantity = movementDetail.getQuantity();
        TypeMovementWarehouse type = movementDetail.getTypeMovementWarehouse();

        try {
            // Buscar stock en el almacén de origen y destino
            Stock stockOrigin = stockRepository.findByWarehouseAndItem(origin, movementDetail.getPart(), movementDetail.getArticle(), movementDetail.getComponent());
            Stock stockDestination = stockRepository.findByWarehouseAndItem(destination, movementDetail.getPart(), movementDetail.getArticle(), movementDetail.getComponent());

            if (type == TypeMovementWarehouse.EXIT) {
                // Salida: restar stock en origen
                if (stockOrigin != null) {
                    stockOrigin.setQuantity(stockOrigin.getQuantity() - quantity);
                    stockRepository.save(stockOrigin);
                } else {
                    throw new OurException("No hay stock disponible en el almacén de origen.");
                }
            } else if (type == TypeMovementWarehouse.ENTRY) {
                // Entrada: sumar stock en destino
                if (stockDestination != null) {
                    stockDestination.setQuantity(stockDestination.getQuantity() + quantity);
                } else {
                    stockDestination = new Stock();
                    stockDestination.setWarehouse(destination);
                    stockDestination.setQuantity(quantity);
                    setStockItem(stockDestination, movementDetail);
                }
                stockRepository.save(stockDestination);
            } else if (type == TypeMovementWarehouse.TRANSFER) {
                // Transferencia: restar en origen y sumar en destino
                if (stockOrigin != null) {
                    stockOrigin.setQuantity(stockOrigin.getQuantity() - quantity);
                    stockRepository.save(stockOrigin);
                } else {
                    throw new OurException("No hay stock suficiente en el almacén de origen.");
                }

                if (stockDestination != null) {
                    stockDestination.setQuantity(stockDestination.getQuantity() + quantity);
                } else {
                    stockDestination = new Stock();
                    stockDestination.setWarehouse(destination);
                    stockDestination.setQuantity(quantity);
                    setStockItem(stockDestination, movementDetail);
                }
                stockRepository.save(stockDestination);
            }
            response.setStatusCode(200);
            response.setMessage("Stock actualizado exitosamente.");
        } catch (OurException e) {
            response.setStatusCode(400);
            response.setMessage(e.getMessage());
        } catch (Exception e) {
            response.setStatusCode(500);
            response.setMessage("Error al actualizar el stock: " + e.getMessage());
        }
        return response;
    }

    // Método auxiliar para asignar el tipo de ítem al stock
    private void setStockItem(Stock stock, MovementDetail movementDetail) {
        if (movementDetail.getPart() != null) {
            stock.setPart(movementDetail.getPart());
        } else if (movementDetail.getArticle() != null) {
            stock.setArticle(movementDetail.getArticle());
        } else if (movementDetail.getComponent() != null) {
            stock.setComponent(movementDetail.getComponent());
        }
    }
}
